{
  "type": "module",
  "name": "cryptomator-hub",
  "version": "2.2.0",
  "description": "Web-Frontend for Cryptomator Hub",
  "author": "Skymatic GmbH",
  "license": "AGPL-3.0-or-later",
  "private": true,
  "main": "index.js",
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "preinstall": "node scripts/check-pm.js",
    "dev": "node scripts/check-pm.js && vite",
    "build": "vue-tsc --noEmit && vite build",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "serve": "vite preview",
    "dist": "node scripts/check-pm.js && vue-tsc --noEmit && vite build --sourcemap --outDir=\"../backend/src/main/resources/META-INF/resources\" --emptyOutDir"
  },
  "directories": {
    "src": "./src",
    "test": "./test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@intlify/devtools-types": "^11.4.12",
    "@intlify/unplugin-vue-i18n": "^11.2.5",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/vite": "^4.3.3",
    "@types/blueimp-md5": "^2.18.2",
    "@types/file-saver": "^2.0.7",
    "@types/node": "^26.6.2",
    "@types/semver": "^7.8.0",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vitest/coverage-v8": "^5.0.1",
    "@vue/compiler-sfc": "^3.5.43",
    "eslint": "^10.11.0",
    "eslint-plugin-vue": "^10.11.0",
    "happy-dom": "^20.14.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "vue-tsc": "^3.3.11"
  },
  "dependencies": {
    "@headlessui/tailwindcss": "^0.2.2",
    "@headlessui/vue": "^1.7.23",
    "@heroicons/vue": "^2.2.0",
    "@noble/ciphers": "^2.4.0",
    "@scure/base": "^2.4.0",
    "altcha": "^3.2.3",
    "axios": "^1.20.0",
    "file-saver": "^2.0.5",
    "jdenticon": "^3.3.0",
    "jszip": "^3.10.2",
    "keycloak-js": "^26.2.4",
    "remeda": "^2.50.0",
    "semver": "^7.8.5",
    "shamir-secret-sharing": "^0.0.4",
    "vue": "^3.5.43",
    "vue-i18n": "^11.4.12",
    "vue-router": "^5.3.1"
  }
}
