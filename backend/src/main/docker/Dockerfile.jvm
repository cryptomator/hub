## Stage 1 : build with maven builder image
FROM quay.io/quarkus/ubi-quarkus-mandrel-builder-image:jdk-25@sha256:1a47e85f8b945cd6819a9551d3e481609ea7fa5a0163d62f666f5e291491837f AS builder
COPY --chown=quarkus:quarkus --chmod=0755 mvnw /code/mvnw
COPY --chown=quarkus:quarkus .mvn /code/.mvn
COPY --chown=quarkus:quarkus pom.xml /code/
USER quarkus
WORKDIR /code
RUN ./mvnw -B quarkus:go-offline --no-transfer-progress
COPY src /code/src
RUN ./mvnw -B package -DskipTests --no-transfer-progress --strict-checksums

## Stage 2 : create the docker final image
FROM eclipse-temurin:25@sha256:68868d04fa9cfd5f5c6abec0b5cef86d8de2bf9c62c37c7d3e4f0f80f5cfd7ff
# remove the CA roots distrusted after the eMudhra key compromise (2026-10-17) from the JDK trust store and from the Ubuntu CA bundle (the "!" prefix deselects a root in ca-certificates.conf)
COPY src/main/docker/remove-distrusted-cacerts.sh /tmp/remove-distrusted-cacerts.sh
RUN sh /tmp/remove-distrusted-cacerts.sh "$JAVA_HOME/lib/security/cacerts" && rm /tmp/remove-distrusted-cacerts.sh \
  && sed -i -E 's#^(mozilla/(emSign_ECC_Root_CA_-_G3|AAA_Certificate_Services)\.crt)$#!\1#' /etc/ca-certificates.conf \
  && update-ca-certificates
COPY --from=builder /code/target/quarkus-app/ /work/
WORKDIR /work/

LABEL org.opencontainers.image.url="https://cryptomator.org/hub/"
LABEL org.opencontainers.image.source="https://github.com/cryptomator/hub"
LABEL org.opencontainers.image.vendor="Skymatic GmbH"
EXPOSE 8080
USER 1001
ENV QUARKUS_HTTP_HOST=0.0.0.0
ENV QUARKUS_MICROMETER_EXPORT_PROMETHEUS_ENABLED=false

CMD ["java", "-jar", "/work/quarkus-run.jar"]